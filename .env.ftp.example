FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=my_user
FTP_PASSWORD=my_password
FTP_REMOTE_ROOT=/httpdocs/assets
# Sibling remote root for the public shared-lead bundle (dist/shared/) — same
# FTP server/host/login as FTP_REMOTE_ROOT above, just a different remote path.
FTP_REMOTE_ROOT_PUBLIC=js/shared
