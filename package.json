{
   "name": "360-customer",
   "private": true,
   "version": "0.0.0",
   "type": "module",
   "scripts": {
      "dev": "vite --mode mock",
      "dev:api": "vite --mode api",
      "build": "vite build --mode production",
      "build:public": "vite build --mode production --config vite.config.public.js",
      "preview": "vite preview",
      "deploy": "npm run build && npm run build:public && node deploy.js",
      "build:dev": "npm run build --buildtarget=dev",
      "build:prod": "npm run build --buildtarget=prod",
      "build:capacitor": "vite build --mode production --config vite.config.capacitor.js",
      "build:capacitor:dev": "npm run build:capacitor --buildtarget=dev",
      "cap:sync": "npm run build:capacitor && npx cap sync android",
      "cap:sync:dev": "npm run build:capacitor:dev && npx cap sync android",
      "cap:open": "npx cap open android",
      "cap:run": "npx cap run android"
   },
   "dependencies": {
      "@capacitor-community/file-opener": "^8.0.1",
      "@capacitor/app": "^8.1.2",
      "@capacitor/app-launcher": "^8.0.1",
      "@capacitor/browser": "^8.0.5",
      "@capacitor/camera": "^8.2.6",
      "@capacitor/core": "^8.6.2",
      "@capacitor/filesystem": "^8.1.5",
      "@capacitor/preferences": "^8.0.1",
      "@capacitor/push-notifications": "^8.1.3",
      "@capacitor/share": "^8.0.3",
      "@capacitor/splash-screen": "^8.0.2",
      "@emotion/cache": "^11.14.0",
      "@emotion/react": "^11.14.0",
      "@emotion/styled": "^11.14.1",
      "@mapbox/polyline": "^1.2.1",
      "@mui/icons-material": "^9.0.1",
      "@mui/material": "^9.0.1",
      "@mui/stylis-plugin-rtl": "^9.5.0",
      "@mui/x-charts": "^9.9.0",
      "@mui/x-data-grid": "^9.9.0",
      "@mui/x-internals": "9.9.0",
      "axios": "^1.16.1",
      "dotenv": "^17.4.2",
      "firebase": "^13.2.0",
      "i18next": "^26.5.11",
      "laravel-echo": "^2.4.0",
      "leaflet": "^1.9.4",
      "pusher-js": "^8.6.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "react-easy-crop": "^6.2.4",
      "react-hook-form": "^7.77.0",
      "react-i18next": "^17.1.9",
      "react-leaflet": "^4.2.1",
      "react-router-dom": "^7.16.0",
      "stylis": "^4.4.0",
      "stylis-plugin-rtl": "^2.1.1",
      "zustand": "^5.0.14"
   },
   "devDependencies": {
      "@capacitor/android": "^8.6.2",
      "@capacitor/assets": "^3.0.5",
      "@capacitor/cli": "^8.6.2",
      "@eslint/js": "^9.17.0",
      "@types/react": "^18.3.18",
      "@types/react-dom": "^18.3.5",
      "@vitejs/plugin-react": "^4.3.4",
      "eslint": "^9.17.0",
      "eslint-plugin-react": "^7.37.2",
      "eslint-plugin-react-hooks": "^5.0.0",
      "eslint-plugin-react-refresh": "^0.4.16",
      "ftp-deploy": "^2.4.7",
      "globals": "^15.14.0",
      "vite": "^6.0.5"
   }
}
